{
    "name": "fyler",
    "private": true,
    "version": "1.2.0",
    "description": "Desktop app for merging PDF files and images into a single PDF, built with Tauri 2.",
    "license": "MIT",
    "author": "gualask",
    "homepage": "https://github.com/gualask/fyler",
    "repository": {
        "type": "git",
        "url": "https://github.com/gualask/fyler.git"
    },
    "bugs": {
        "url": "https://github.com/gualask/fyler/issues"
    },
    "packageManager": "pnpm@11.22.0",
    "type": "module",
    "scripts": {
        "format": "biome format --write .",
        "i18n:check": "node scripts/check-i18n.mjs",
        "knip": "knip",
        "lint": "biome check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "build:standalone": "pnpm typecheck && vite build --mode standalone",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "tauri:build:standalone": "node scripts/build-standalone.mjs"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tabler/icons-react": "^3.46.0",
        "@tanstack/react-query": "^5.101.4",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "motion": "^13.1.1",
        "pdfjs-dist": "^6.2.108",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.9",
        "@rolldown/plugin-transform-imports": "^0.1.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "knip": "^6.32.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
